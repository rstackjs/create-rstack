{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./dist",
    "target": "ES2023",
    "lib": ["DOM", "ESNext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
